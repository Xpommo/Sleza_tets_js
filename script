  // Заглушки для 5 AI-законов — рендерятся всегда, даже если Groq недоступен.
  // Локальные переопределения (152-ФЗ от check152FZ, 149-ФЗ от ЕГРЮЛ) применяются поверх.
  const AI_LAW_STUBS = [
    { law: 'Упоминание наркотиков',             law_code: 'ст.6.13 КоАП, ФЗ №3',         fine: 'до 1 500 000 руб.',        status: 'unknown', issue: '', location: '', found_text: '', action: '' },
    { law: '152-ФЗ — персональные данные',       law_code: '152-ФЗ, ст.13.11 КоАП',       fine: 'до 300 000 руб.',           status: 'unknown', issue: '', location: '', found_text: '', action: '' },
    { law: 'Маркировка рекламы (ЕРИР)',          law_code: 'ФЗ №347, ст.14.3 КоАП',       fine: '100 000 — 500 000 руб.',    status: 'unknown', issue: '', location: '', found_text: '', action: '' },
    { law: '149-ФЗ — информация о владельце',    law_code: '149-ФЗ ст.10, ст.13.31 КоАП', fine: 'до 100 000 руб.',           status: 'unknown', issue: '', location: '', found_text: '', action: '' },
    { law: 'Публичная оферта и условия возврата',law_code: 'ГК РФ ст.435, ЗоЗПП ст.26.1', fine: 'до 500 000 руб.',           status: 'unknown', issue: '', location: '', found_text: '', action: '' },
  ];

  function renderResults({ mode, origin, hostname, pages, aiData, source, egrul, stats, slezaError, spaWarning }) {
    // Аггрегация по реестру
    const allItems = pages.flatMap(p => p.items);
    const inoItems = allItems.filter(i => i.category === 'inoagent');
    const extItems = allItems.filter(i => i.category === 'extremist' || i.category === 'terrorist');
    const inoUnmarked = inoItems.filter(i => !i.hasMarking);
    const extUnmarked = extItems.filter(i => !i.hasMarking);

    const aiWorked = aiData && aiData.checks && aiData.checks.length > 0;
    const aiError  = aiData && aiData.error;
    const aiChecks = aiWorked
      ? aiData.checks
      : AI_LAW_STUBS.map(s => ({
          ...s,
          // Для законов без локального переопределения — сообщаем, что нужен GROQ_KEY
          issue:  s.law_code.includes('152-ФЗ') || s.law_code.includes('149-ФЗ') ? '' : 'Требуется AI-анализ — заполните GROQ_KEY в настройках скрипта',
          action: s.law_code.includes('152-ФЗ') || s.law_code.includes('149-ФЗ') ? '' : 'Добавьте GROQ_KEY и повторите сканирование',
        }));
    const totalSlezaUnmarked = inoUnmarked.length + extUnmarked.length;
    const totalAIViolations = aiChecks.filter(c => c.status === 'violation').length;
    const totalViolations = totalSlezaUnmarked + totalAIViolations;

    let riskCls, riskTitle, riskDesc;
    if (totalViolations >= 5 || totalSlezaUnmarked >= 3) {
      riskCls = 'high'; riskTitle = 'ВЫСОКИЙ РИСК'; riskDesc = 'Множественные нарушения по сайту. Срочно требуется маркировка.';
    } else if (totalViolations >= 1) {
      riskCls = 'medium'; riskTitle = 'СРЕДНИЙ РИСК'; riskDesc = 'Есть нарушения, требуется устранение.';
    } else {
      riskCls = 'low'; riskTitle = 'НИЗКИЙ РИСК'; riskDesc = 'Критических нарушений не выявлено.';
    }

    const pagesWithIssues = pages.filter(p => p.items.some(i => !i.hasMarking));
    const okPages = pages.filter(p => p.items.length > 0 && !p.items.some(i => !i.hasMarking));

    const bd = document.getElementById('sz-bd');
    bd.innerHTML = `
      <div class="sz-sum ${riskCls}">
        <div>
          <div class="sz-sl">Сайт: <span>${escapeHtml(aiData?.site_name || hostname)}</span>${aiData?.site_type ? ` · ${escapeHtml(aiData.site_type)}` : ''}</div>
          <div class="sz-rt c-${riskCls}">${riskTitle}</div>
          <div class="sz-rd">${escapeHtml(aiData?.summary || riskDesc)}</div>
        </div>
        <div>
          <div class="sz-sc c-${riskCls}">${totalViolations}</div>
          <div class="sz-scl">НАРУШЕНИЙ</div>
        </div>
      </div>

      ${mode === 'full' ? `
      <div class="sz-stats-row">
        <div class="sz-stat">
          <div class="sz-stat-num">${pages.length}</div>
          <div class="sz-stat-lbl">Страниц проверено</div>
        </div>
        <div class="sz-stat">
          <div class="sz-stat-num ${allItems.length > 0 ? 'warn' : 'ok'}">${allItems.length}</div>
          <div class="sz-stat-lbl">Упоминаний</div>
        </div>
        <div class="sz-stat">
          <div class="sz-stat-num ${totalSlezaUnmarked > 0 ? 'bad' : 'ok'}">${totalSlezaUnmarked}</div>
          <div class="sz-stat-lbl">Без маркировки</div>
        </div>
        <div class="sz-stat">
          <div class="sz-stat-num ${pagesWithIssues.length > 0 ? 'bad' : 'ok'}">${pagesWithIssues.length}</div>
          <div class="sz-stat-lbl">Проблемных стр.</div>
        </div>
      </div>
      <div style="font-family:'Courier New',monospace;font-size:10px;color:#64748b;margin-bottom:14px;text-align:center;line-height:1.7">
        // источник: ${source === 'sitemap' ? 'sitemap.xml' : source === 'sitemap-index' ? 'sitemap-index' : 'обход страниц'} · максимум: ${MAX_PAGES} страниц
        ${stats ? `<br>// приоритизация: <span style="color:#4ade80">📰 ${stats.highScanned} из ${stats.totalHighFound} контентн.</span> · <span style="color:#94a3b8">🏢 ${stats.mid} корпорат.</span>${stats.low > 0 ? ` · <span style="color:#64748b">📄 ${stats.low} прочих</span>` : ''}${stats.skipped > 0 ? ` · <span style="color:#475569">✗ ${stats.skipped} тех.страниц пропущено</span>` : ''}${stats.yearRange ? `<br>// покрытие архива: <span style="color:#60a5fa">📅 ${stats.yearRange}</span> · ${stats.yearsCovered.length} ${plural(stats.yearsCovered.length, 'год', 'года', 'лет')}` : ''}` : ''}
        ${(() => {
          const skippedCount = pages.filter(p => p.skipped).length;
          const apiCalled = pages.length - skippedCount - pages.filter(p => p.error).length;
          const otherItems = allItems.filter(i => i.category !== 'inoagent' && i.category !== 'extremist' && i.category !== 'terrorist');
          const debugHint = apiCalled === 0
            ? `<br>// <span style="color:#f87171">⚠ API Слезы: 0 вызовов — все страницы пропущены предфильтром</span>`
            : allItems.length === 0
              ? `<br>// <span style="color:#fbbf24">⚠ API Слезы: ${apiCalled} вызовов → 0 упоминаний в реестре</span>`
              : otherItems.length > 0
                ? `<br>// <span style="color:#fbbf24">API нашёл ${allItems.length} упоминаний (${otherItems.length} не классифицированы)</span>`
                : '';
          const filterHint = skippedCount > 0
            ? `<br>// предфильтр: <span style="color:#60a5fa">🔍 ${apiCalled} API-запросов</span> · <span style="color:#4ade80">⚡ ${skippedCount} страниц пропущено без API</span> · экономия ${Math.round(skippedCount / pages.length * 100)}%`
            : '';
          return debugHint + filterHint;
        })()}
      </div>
      ` : ''}

      <div class="sz-acts">
        <button class="sz-abtn" onclick="window.print()">⬇ Печать / PDF</button>
      </div>

      <div class="sz-cl">// результаты по 7 законам</div>
      ${slezaError ? `<div style="background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.3);border-radius:8px;padding:10px 14px;margin-bottom:10px;font-family:'Courier New',monospace;font-size:11px;color:#f87171;line-height:1.6">
        ⚠ API Слезы недоступен (${escapeHtml(String(slezaError))})<br>
        <span style="color:#94a3b8">${
          slezaError === 'no_key' ? 'SLEZA_KEY не заполнен — откройте скрипт в Tampermonkey и впишите ключ в строке 22.' :
          /^http_(401|403)/.test(slezaError) ? 'Неверный SLEZA_KEY — проверьте API-ключ в настройках скрипта (строка ~22).' :
          /^http_422/.test(slezaError) ? 'Подписка на sleza.media неактивна — войдите в аккаунт и активируйте подписку.' :
          /^http_/.test(slezaError) ? 'API вернул ошибку. Проверьте статус sleza.media.' :
          slezaError === 'timeout' ? 'API не ответил за 10 сек. Возможно перегрузка — попробуйте позже.' :
          slezaError === 'net' ? 'Сетевая ошибка при обращении к sleza.media.' :
          slezaError === 'parse' || /^parse_http_/.test(slezaError) ? 'API вернул не-JSON ответ.' :
          'Иноагенты и экстремисты не проверены — отчёт неполный.'
        }</span>
      </div>` : ''}
      ${aiError ? `<div style="background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.3);border-radius:8px;padding:10px 14px;margin-bottom:10px;font-family:'Courier New',monospace;font-size:11px;color:#fbbf24;line-height:1.6">
        ⚠ AI-анализ недоступен (${escapeHtml(String(aiError))})<br>
        <span style="color:#94a3b8">152-ФЗ и 149-ФЗ проверены локально. Остальные законы требуют GROQ_KEY — заполните в настройках скрипта.</span>
      </div>` : ''}
      ${spaWarning ? `<div style="background:rgba(96,165,250,.08);border:1px solid rgba(96,165,250,.3);border-radius:8px;padding:10px 14px;margin-bottom:10px;font-family:'Courier New',monospace;font-size:11px;color:#60a5fa;line-height:1.6">
        ⚡ Сайт использует JavaScript-рендеринг (React / Vue / Next.js)<br>
        <span style="color:#94a3b8">Подстраницы (политика, оферта, реквизиты) загружаются как пустой HTML-шаблон — часть данных может быть не найдена. Для точной проверки откройте нужную страницу в браузере и запустите <strong style="color:#e2e8f0">«Текущая страница»</strong>.</span>
      </div>` : ''}
      ${stats?.usedFallback ? `<div style="background:rgba(251,191,36,.08);border:1px solid rgba(251,191,36,.3);border-radius:8px;padding:10px 14px;margin-bottom:10px;font-family:'Courier New',monospace;font-size:11px;color:#fbbf24;line-height:1.6">
        ⚠ Нестандартная структура URL — приоритизация не сработала<br>
        <span style="color:#94a3b8">В sitemap найдено ${stats.totalDiscovered} URL, но все попали под фильтр «технических страниц». Скан выполнен по всем URL без приоритета — результаты могут быть менее релевантными. Откройте DevTools (F12) → Console для деталей: какие URL и по какому правилу отброшены.</span>
      </div>` : ''}
      <div class="sz-checks">
        ${renderSlezaCheck(inoItems, 'Маркировка иноагентов', 'ФЗ №121, №255-ФЗ', '40 000 — 500 000 руб.', pages, 'inoagent')}
        ${renderSlezaCheck(extItems, 'Маркировка экстремистов / террористов', 'ст.13.15 КоАП, ФЗ №114', 'до 500 000 руб.', pages, 'extremist')}
        ${aiChecks.map((ch, i) => renderAICheck(ch, i, egrul, aiData?.result152, aiData?.result149)).join('')}
      </div>

      <div class="sz-cta">
        <div>
          <div class="sz-ctat">Автомаркировка на всех страницах сразу?</div>
          <div class="sz-ctas">JS-скрипт Слеза + полный реестр + автообновления 24/7</div>
        </div>
        <div class="sz-ctal">sleza.media →</div>
      </div>

      <div class="sz-disc">
        // Иноагенты/экстремисты: официальный API sleza.media (актуально)<br>
        // Остальные законы: AI-анализ (предварительная оценка)<br>
        // ${pages.length} страниц проверено · полный аудит — sleza.media
      </div>`;

    // Обработчики
    bd.querySelectorAll('.sz-loc-btn[data-check-idx]').forEach(btn => {
      btn.onclick = (e) => {
        e.preventDefault();
        const idx = parseInt(btn.getAttribute('data-check-idx'), 10);
        const ch = aiChecks[idx];
        if (!ch) return;
        const target = findElementByText(ch.found_text);
        if (target) { setModalDimmed(true); highlightElement(target); }
      };
    });
    bd.querySelectorAll('[data-find-name][data-page-url]').forEach(btn => {
      btn.onclick = (e) => {
        e.preventDefault();
        const url = btn.getAttribute('data-page-url');
        const name = decodeURIComponent(btn.getAttribute('data-find-name'));
        if (url === location.href) {
          const target = findElementByText(name);
          if (target) { setModalDimmed(true); highlightElement(target); }
        } else {
          window.open(url, '_blank');
        }
      };
    });
  }

  function renderSlezaCheck(items, title, code, fine, pages, type) {
    const unmarked = items.filter(i => !i.hasMarking);
    const marked = items.filter(i => i.hasMarking);

    let status, issue, action;
    if (items.length === 0) {
      status = 'ok'; issue = 'Упоминаний не найдено на сайте'; action = '—';
    } else if (unmarked.length === 0) {
      status = 'ok';
      issue = `${items.length} ${plural(items.length, 'упоминание','упоминания','упоминаний')} с корректной маркировкой`;
      action = 'Поддерживайте маркировку при новых публикациях';
    } else {
      status = 'violation';
      issue = `${unmarked.length} ${plural(unmarked.length, 'упоминание','упоминания','упоминаний')} БЕЗ маркировки на ${countPagesWith(pages, type)} ${plural(countPagesWith(pages, type), 'странице','страницах','страницах')}`;
      action = 'Добавить маркировку на каждой указанной странице';
    }

    const st = ST[status];
    const pagesBlock = items.length > 0 ? renderPagesList(pages, type) : '';

    return `
      <div class="sz-check ${st.cls}">
        <div class="sz-ct">
          <div>
            <div class="sz-ln">${title}</div>
            <div class="sz-lc">${code} · API Слезы</div>
          </div>
          <div class="sz-pill ${st.cls}">${st.label}</div>
        </div>
        <div class="sz-grid">
          <div class="sz-full">
            <div class="sz-fl">// результат</div>
            <div class="sz-fv iss">${issue}</div>
            ${pagesBlock}
          </div>
          <div>
            <div class="sz-fl">// штраф</div>
            <div class="sz-fv">${fine}</div>
          </div>
          <div>
            <div class="sz-fl">// что нужно сделать</div>
            <div class="sz-fv">${action}</div>
          </div>
        </div>
      </div>`;
  }

  function countPagesWith(pages, type) {
    return pages.filter(p => p.items.some(i =>
      !i.hasMarking && (type === 'inoagent' ? i.category === 'inoagent' : (i.category === 'extremist' || i.category === 'terrorist'))
    )).length;
  }

  function renderPagesList(pages, type) {
    const filtered = pages.filter(p => p.items.some(i =>
      type === 'inoagent' ? i.category === 'inoagent' : (i.category === 'extremist' || i.category === 'terrorist')
    ));
    if (filtered.length === 0) return '';

    return `<div class="sz-pages-list">
      ${filtered.map(p => {
        const relevant = p.items.filter(i =>
          type === 'inoagent' ? i.category === 'inoagent' : (i.category === 'extremist' || i.category === 'terrorist')
        );
        const unmarked = relevant.filter(i => !i.hasMarking);
        const marked = relevant.filter(i => i.hasMarking);
        const isBad = unmarked.length > 0;
        const shortUrl = p.url.replace(location.origin, '') || '/';

        return `<div class="sz-page-item ${isBad ? 'bad' : ''}">
          <a class="sz-page-url" href="${p.url}" target="_blank">${shortUrl}${p.isCurrent ? ' · текущая' : ''}</a>
          <div style="font-family:'Courier New',monospace;font-size:9px;color:#64748b;margin-bottom:4px">
            ${unmarked.length > 0 ? `<span style="color:#f87171;font-weight:700">✗ ${unmarked.length} без маркировки</span>` : ''}
            ${unmarked.length > 0 && marked.length > 0 ? ' · ' : ''}
            ${marked.length > 0 ? `<span style="color:#4ade80">✓ ${marked.length} с маркировкой</span>` : ''}
          </div>
          ${unmarked.length > 0 ? `<div class="sz-page-violations">
            ${unmarked.map(item => `
              <div class="sz-page-violation">
                <span class="name">${escapeHtml(item.name)}</span>
                <span class="mark">→ «${escapeHtml(item.marking.slice(0, 60))}${item.marking.length > 60 ? '...' : ''}»</span>
                ${p.isCurrent ? `<button data-find-name="${encodeURIComponent(item.name)}" data-page-url="${escapeHtml(p.url)}" style="font-family:inherit;font-size:9px;background:#1a2235;border:1px solid #2d3f5a;color:#60a5fa;padding:1px 6px;border-radius:3px;cursor:pointer">📍</button>` : ''}
              </div>
            `).join('')}
          </div>` : ''}
        </div>`;
      }).join('')}
    </div>`;
  }

  function plural(n, one, two, many) {
    const m = n % 10; const m2 = n % 100;
    if (m2 >= 11 && m2 <= 14) return many;
    if (m === 1) return one;
    if (m >= 2 && m <= 4) return two;
    return many;
  }

  function renderAICheck(ch, i, egrul, result152, result149) {
    const st = ST[ch.status] || ST.unknown;
    const showLoc = ch.status !== 'ok' && ch.status !== 'unknown' && ch.found_text && !ch.found_text.toLowerCase().includes('отсутств');
    const showQuote = ch.found_text && !ch.found_text.toLowerCase().includes('отсутств') && ch.status !== 'ok';

    // Блок верификации ЕГРЮЛ — только для 149-ФЗ
    let egrulBlock = '';
    if (egrul && egrul.checked && (ch.law_code || '').includes('149-ФЗ')) {
      egrulBlock = renderEgrulBlock(egrul);
    }

    // Блок чек-листа 152-ФЗ
    let block152 = '';
    if (result152 && (ch.law_code || '').includes('152-ФЗ')) {
      block152 = render152Block(result152);
    }

    // Блок чек-листа 149-ФЗ
    let block149 = '';
    if (result149 && (ch.law_code || '').includes('149-ФЗ')) {
      block149 = render149Block(result149);
    }

    // Если есть локальный чек — переопределяем статус карточки
    let effectiveStatus = ch.status;
    let effectiveLabel = ST[ch.status]?.label || 'НЕТ ДАННЫХ';
    let effectiveCls = ST[ch.status]?.cls || 'unknown';
    if (result152 && (ch.law_code || '').includes('152-ФЗ')) {
      if (result152.status === 'ok') { effectiveStatus = 'ok'; effectiveLabel = ST.ok.label; effectiveCls = ST.ok.cls; }
      else if (result152.status === 'risk') { effectiveStatus = 'risk'; effectiveLabel = ST.risk.label; effectiveCls = ST.risk.cls; }
      else if (result152.status === 'violation' || result152.status === 'no_policy') { effectiveStatus = 'violation'; effectiveLabel = ST.violation.label; effectiveCls = ST.violation.cls; }
    }
    if (result149 && (ch.law_code || '').includes('149-ФЗ')) {
      // ЕГРЮЛ может ужесточить статус: организация прекращена → нарушение независимо от чек-листа
      const egrulInactive = egrul?.result?.parsed && egrul.result.parsed.isActive === false;
      let local = result149.status;
      if (egrulInactive) local = 'violation';
      if (local === 'ok') { effectiveStatus = 'ok'; effectiveLabel = ST.ok.label; effectiveCls = ST.ok.cls; }
      else if (local === 'risk') { effectiveStatus = 'risk'; effectiveLabel = ST.risk.label; effectiveCls = ST.risk.cls; }
      else if (local === 'violation') { effectiveStatus = 'violation'; effectiveLabel = ST.violation.label; effectiveCls = ST.violation.cls; }
    }

    return `
      <div class="sz-check ${effectiveCls}">
        <div class="sz-ct">
          <div>
            <div class="sz-ln">${escapeHtml(ch.law)}</div>
            <div class="sz-lc">${escapeHtml(ch.law_code)}${egrulBlock ? ' · ЕГРЮЛ' : ''}${block152 || block149 ? ' · чек-лист' : ''}</div>
          </div>
          <div class="sz-pill ${effectiveCls}">${effectiveLabel}</div>
        </div>
        <div class="sz-grid">
          <div class="sz-full">
            <div class="sz-fl">// что обнаружено</div>
            <div class="sz-fv iss">${escapeHtml(ch.issue || '—')}</div>
            ${egrulBlock}
            ${block152}
            ${block149}
            ${showLoc ? `<button class="sz-loc-btn" data-check-idx="${i}"><span class="sz-loc-icon">📍</span><span class="sz-loc-label">${escapeHtml(ch.location || 'на странице')}</span></button>` : ''}
            ${showQuote ? `<div class="sz-quote">"${escapeHtml(ch.found_text)}"</div>` : ''}
          </div>
          <div>
            <div class="sz-fl">// штраф</div>
            <div class="sz-fv">${escapeHtml(ch.fine || '—')}</div>
          </div>
          <div>
            <div class="sz-fl">// что нужно сделать</div>
            <div class="sz-fv">${escapeHtml(ch.action || '—')}</div>
          </div>
        </div>
      </div>`;
  }

  function render152Block(r) {
    // Политика не найдена
    if (r.status === 'no_policy') {
      return `<div class="sz-egrul-block bad">
        <div class="sz-egrul-title">⚠ Политика конфиденциальности НЕ НАЙДЕНА</div>
        <div class="sz-egrul-desc">По 152-ФЗ оператор обязан опубликовать политику конфиденциальности с 7 обязательными пунктами (ст. 18.1).</div>
      </div>`;
    }

    const cls = r.status === 'ok' ? 'good' : r.status === 'risk' ? 'warn' : 'bad';
    const icon = r.status === 'ok' ? '✓' : r.status === 'risk' ? '⚠' : '✗';
    const title = r.status === 'ok' ? `Политика полная (${r.found} из ${r.total})` :
                  r.status === 'risk' ? `Политика неполная (${r.found} из ${r.total})` :
                  `Критические пробелы (${r.found} из ${r.total})`;

    const items = r.items.map(item => {
      const isAi = item.present && item.confirmedBy === 'ai';
      const iconChar = item.present ? (isAi ? '◆' : '✓') : '✗';
      const iconCls = item.present ? (isAi ? 'ai' : 'ok') : 'miss';
      const titleAttr = isAi && item.quote ? ` title="Подтверждено AI: «${escapeHtml(item.quote)}»"` : '';
      return `<div class="sz-152-row"${titleAttr}>
        <span class="sz-152-icon ${iconCls}">${iconChar}</span>
        <span class="sz-152-label ${item.present ? '' : 'miss'}">${escapeHtml(item.label)}${isAi ? ' <span style="font-family:\'Courier New\',monospace;font-size:9px;color:#60a5fa">· AI</span>' : ''}</span>
      </div>`;
    }).join('');

    const missingItems = r.items.filter(i => !i.present);
    const aiCount = r.items.filter(i => i.present && i.confirmedBy === 'ai').length;
    let desc;
    if (missingItems.length > 0) {
      desc = `Отсутствует: ${escapeHtml(missingItems.map(i => i.label.toLowerCase()).join('; '))}.`;
    } else if (aiCount > 0) {
      desc = `Политика содержит все обязательные пункты по ст. 18.1 152-ФЗ (${aiCount} ${aiCount === 1 ? 'пункт подтверждён' : 'пунктов подтверждено'} AI после локального чек-листа).`;
    } else {
      desc = 'Политика содержит все обязательные пункты по ст. 18.1 152-ФЗ.';
    }

    return `<div class="sz-egrul-block ${cls}">
      <div class="sz-egrul-title">${icon} ${title}</div>
      <div class="sz-152-list">${items}</div>
      <div class="sz-egrul-desc">${desc}</div>
    </div>`;
  }

  function render149Block(r) {
    const cls = r.status === 'ok' ? 'good' : r.status === 'risk' ? 'warn' : 'bad';
    const icon = r.status === 'ok' ? '✓' : r.status === 'risk' ? '⚠' : '✗';
    const title = r.status === 'ok' ? `Реквизиты полные (${r.found} из ${r.total})` :
                  r.status === 'risk' ? `Реквизиты неполные (${r.found} из ${r.total})` :
                  `Критические пробелы (${r.found} из ${r.total})`;

    const items = r.items.map(item => {
      const iconChar = item.present ? '✓' : '✗';
      const iconCls = item.present ? 'ok' : 'miss';
      return `<div class="sz-152-row">
        <span class="sz-152-icon ${iconCls}">${iconChar}</span>
        <span class="sz-152-label ${item.present ? '' : 'miss'}">${escapeHtml(item.label)}</span>
      </div>`;
    }).join('');

    const missing = r.items.filter(i => !i.present);
    const desc = missing.length > 0
      ? `Отсутствует на сайте: ${escapeHtml(missing.map(i => i.label.toLowerCase()).join('; '))}.`
      : 'Все обязательные реквизиты владельца указаны на сайте.';

    return `<div class="sz-egrul-block ${cls}">
      <div class="sz-egrul-title">${icon} ${title}</div>
      <div class="sz-152-list">${items}</div>
      <div class="sz-egrul-desc">${desc}</div>
    </div>`;
  }

  function renderEgrulBlock(egrul) {
    const ids = egrul.ids;
    const res = egrul.result;

    // Реквизиты не найдены на сайте
    if (!ids.inn && !ids.ogrn) {
      return `<div class="sz-egrul-block bad">
        <div class="sz-egrul-title">⚠ Реквизиты НЕ НАЙДЕНЫ на сайте</div>
        <div class="sz-egrul-desc">По 149-ФЗ ст.10 ИНН и ОГРН должны быть размещены публично — обычно в подвале или на странице "О компании".</div>
      </div>`;
    }

    // Реквизиты найдены, но не проверены или не нашлись в ФНС
    if (!res || !res.found) {
      return `<div class="sz-egrul-block warn">
        <div class="sz-egrul-title">⚠ ИНН/ОГРН не подтверждён в ФНС</div>
        <div class="sz-egrul-row"><span>На сайте:</span> ИНН ${escapeHtml(ids.inn||'—')}, ОГРН ${escapeHtml(ids.ogrn||'—')}</div>
        <div class="sz-egrul-row"><span>Ошибка:</span> ${escapeHtml(res?.error || 'данные не вернулись')}</div>
        <div class="sz-egrul-desc">Возможно: ИНН неверный, организация ликвидирована, или сервис временно недоступен.</div>
      </div>`;
    }

    // ВСЁ ОК
    const p = res.parsed;
    const cls = p.isActive ? 'good' : 'bad';
    const statusIcon = p.isActive ? '✓' : '✗';
    return `<div class="sz-egrul-block ${cls}">
      <div class="sz-egrul-title">${statusIcon} Реквизиты сверены с ФНС</div>
      <div class="sz-egrul-row"><span>Тип:</span> ${p.type === 'ip' ? 'Индивидуальный предприниматель' : 'Юридическое лицо'}</div>
      <div class="sz-egrul-row"><span>Название:</span> ${escapeHtml(p.name || '—')}</div>
      ${p.inn ? `<div class="sz-egrul-row"><span>ИНН:</span> ${escapeHtml(p.inn)}</div>` : ''}
      ${p.ogrn ? `<div class="sz-egrul-row"><span>ОГРН:</span> ${escapeHtml(p.ogrn)}</div>` : ''}
      ${p.kpp ? `<div class="sz-egrul-row"><span>КПП:</span> ${escapeHtml(p.kpp)}</div>` : ''}
      ${p.address ? `<div class="sz-egrul-row"><span>Адрес:</span> ${escapeHtml(p.address)}</div>` : ''}
      ${p.regDate ? `<div class="sz-egrul-row"><span>Дата рег.:</span> ${escapeHtml(p.regDate)}</div>` : ''}
      <div class="sz-egrul-row"><span>Статус:</span> <strong class="${p.isActive ? 'ok' : 'bad'}">${p.isActive ? 'ДЕЙСТВУЮЩАЯ' : 'ПРЕКРАЩЕНА'}</strong></div>
      ${!p.isActive && p.reason ? `<div class="sz-egrul-desc">${escapeHtml(p.reason)} — критическое нарушение, сайт нельзя использовать для коммерческой деятельности.</div>` : ''}
    </div>`;
  }
})();
