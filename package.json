{
  "name": "sleza-tets-js",
  "version": "0.0.0",
  "private": true,
  "description": "Tampermonkey compliance scanner — test suite",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=test-results.xml",
    "test:html": "vitest run --reporter=html",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "vitest": "^2.1.9"
  }
}
